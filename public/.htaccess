Options -MultiViews
RewriteEngine On

# ES module files (e.g. pdf.js web worker) must be served as JavaScript
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

# Backend PHP files   Apache directly serve kare, SPA intercept na kare
RewriteCond %{REQUEST_URI} ^/obeliskrx/backend/ [NC]
RewriteRule ^ - [L]

# Existing files aur directories seedha serve karo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Baqi sab routes → SPA index.html
RewriteRule ^ index.html [L]
